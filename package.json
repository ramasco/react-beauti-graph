{
  "name": "react-beauti-graph",
  "version": "1.3.2",
  "description": "React graph component built on Cytoscape: groups, grid layout, two-way arrows, search, details panel and clipboard export.",
  "keywords": [
    "react",
    "graph",
    "cytoscape",
    "dependency-graph",
    "network",
    "diagram",
    "visualization"
  ],
  "author": "Antonio Ramasco",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ramasco/react-beauti-graph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramasco/react-beauti-graph.git"
  },
  "bugs": {
    "url": "https://github.com/ramasco/react-beauti-graph/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npm --prefix examples run dev",
    "build": "npm --prefix examples run build",
    "start": "npm --prefix examples run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lib": "vite build -c vite.lib.config.mjs && node node_modules/typescript7/bin/tsc -p tsconfig.build.json && node scripts/make-cts.mjs",
    "prepublishOnly": "npm test && npm run build:lib",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit && node node_modules/typescript7/bin/tsc --noEmit -p examples",
    "smoke": "npm --prefix examples run build && node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "cytoscape": "^3.26.0",
    "cytoscape-svg": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "types": "./dist/index.d.ts"
}
