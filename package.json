{
  "name": "react-beauti-graph",
  "version": "1.1.0",
  "description": "React graph component built on Cytoscape: folders, grid layout, two-way arrows, search, details panel and clipboard export.",
  "keywords": [
    "react",
    "graph",
    "cytoscape",
    "dependency-graph",
    "network",
    "diagram",
    "visualization"
  ],
  "author": "Antonio Ramasco",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ramasco/react-beauti-graph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramasco/react-beauti-graph.git"
  },
  "bugs": {
    "url": "https://github.com/ramasco/react-beauti-graph/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npm --prefix examples run dev",
    "build": "npm --prefix examples run build",
    "start": "npm --prefix examples run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lib": "vite build -c vite.lib.config.mjs",
    "prepublishOnly": "npm test && npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "cytoscape": "^3.26.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "types": "./dist/index.d.ts"
}
